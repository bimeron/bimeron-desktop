cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/core-release.cmake")
if(NOT BIMERON_CORE_RELEASE_SUPPORTS_SOURCE_UPDATE)
    message(FATAL_ERROR "Pinned core ${BIMERON_CORE_VERSION} lacks the trusted -source updater; pin an official release with final SHA-256 values before packaging")
endif()

if(NOT DEFINED BIMERON_CORE_PLATFORM)
    string(TOLOWER "${CMAKE_HOST_SYSTEM_NAME}" BIMERON_CORE_PLATFORM)
endif()
if(BIMERON_CORE_PLATFORM STREQUAL "windows")
    set(targets ${BIMERON_CORE_TARGETS_windows})
elseif(BIMERON_CORE_PLATFORM STREQUAL "linux")
    set(targets ${BIMERON_CORE_TARGETS_linux})
elseif(BIMERON_CORE_PLATFORM STREQUAL "all")
    set(targets ${BIMERON_CORE_TARGETS_windows} ${BIMERON_CORE_TARGETS_linux})
else()
    message(FATAL_ERROR "Unsupported BIMERON_CORE_PLATFORM: ${BIMERON_CORE_PLATFORM}")
endif()

if(NOT DEFINED BIMERON_CORE_ROOT)
    set(BIMERON_CORE_ROOT "${BIMERON_CORE_ROOT_DEFAULT}")
endif()
set(root "${BIMERON_CORE_ROOT}")
file(MAKE_DIRECTORY "${root}")
foreach(target IN LISTS targets)
    string(REPLACE "-" "_" key "${target}")
    set(name "bimeron-${BIMERON_CORE_VERSION}-${target}.zip")
    set(archive "${root}/${name}")
    set(checksum "${BIMERON_CORE_SHA256_${key}}")
    if(EXISTS "${archive}")
        file(SHA256 "${archive}" actual)
    endif()
    if(NOT actual STREQUAL checksum)
        file(DOWNLOAD
            "${BIMERON_CORE_REPOSITORY_URL}/releases/download/${BIMERON_CORE_VERSION}/${name}"
            "${archive}"
            EXPECTED_HASH "SHA256=${checksum}"
            STATUS status)
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            message(FATAL_ERROR "Core download failed for ${name}: ${status}")
        endif()
    endif()
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${root}")
    string(REGEX REPLACE "-.*$" "" platform "${target}")
    foreach(name IN LISTS BIMERON_CORE_FILES_${platform})
        if(NOT EXISTS "${root}/${target}/${name}")
            message(FATAL_ERROR "Core release is missing ${target}/${name}")
        endif()
    endforeach()
    message(STATUS "Core ${BIMERON_CORE_VERSION} ${target} ready")
    unset(actual)
endforeach()
