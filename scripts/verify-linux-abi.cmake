cmake_minimum_required(VERSION 3.21)
if(NOT EXISTS "${BIMERON_LINUX_EXECUTABLE}")
    message(FATAL_ERROR "Linux ABI check requires an existing BIMERON_LINUX_EXECUTABLE")
endif()
find_program(BIMERON_READELF readelf REQUIRED)
execute_process(COMMAND "${BIMERON_READELF}" --version-info "${BIMERON_LINUX_EXECUTABLE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE versions ERROR_VARIABLE diagnostic)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect Linux ABI: ${diagnostic}")
endif()
# Build on the oldest supported userspace. Metadata alone cannot make a binary
# linked against newer Qt/glibc/libstdc++ run on Ubuntu 22.04.
foreach(runtime IN ITEMS GLIBC GLIBCXX CXXABI Qt)
    if(runtime STREQUAL "GLIBC")
        set(maximum "2.35")
    elseif(runtime STREQUAL "GLIBCXX")
        set(maximum "3.4.29")
    elseif(runtime STREQUAL "CXXABI")
        set(maximum "1.3.13")
    else()
        set(maximum "6.2")
    endif()
    string(REGEX MATCHALL "${runtime}_[0-9]+(\\.[0-9]+)*" required "${versions}")
    foreach(symbol IN LISTS required)
        string(REPLACE "${runtime}_" "" version "${symbol}")
        if(version VERSION_GREATER maximum)
            message(FATAL_ERROR "${BIMERON_LINUX_EXECUTABLE} requires ${symbol}; Ubuntu 22.04 baseline allows ${runtime}_${maximum}. Build the DEBs on Ubuntu 22.04 with Qt 6.2/GCC 11.")
        endif()
    endforeach()
endforeach()
message(STATUS "Ubuntu 22.04 ABI baseline verified: ${BIMERON_LINUX_EXECUTABLE}")
