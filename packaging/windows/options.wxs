<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Property Id="CREATE_START_MENU_SHORTCUT" Value="1" />
    <Property Id="LAUNCH_AFTER_INSTALL" Value="1" />

    <DirectoryRef Id="TARGETDIR">
      <Directory Id="ProgramMenuFolder" Name="Programs">
        <Directory Id="PROGRAM_MENU_FOLDER" Name="Bimeron" />
      </Directory>
      <Directory Id="DesktopFolder" Name="DesktopFolder" />
    </DirectoryRef>

    <DirectoryRef Id="PROGRAM_MENU_FOLDER">
      <Component Id="BimeronStartMenuShortcut" Guid="*">
        <Condition>CREATE_START_MENU_SHORTCUT = 1</Condition>
        <Shortcut Id="BimeronStartMenuShortcutEntry"
                  Name="Bimeron"
                  Target="[#CM_FP_bimeron_desktop.exe]"
                  WorkingDirectory="INSTALL_ROOT" />
        <RemoveFolder Id="RemoveBimeronProgramMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Bimeron Network\bimeron-desktop"
                       Name="startMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="BimeronDesktopShortcut" Guid="*">
        <Condition>CREATE_DESKTOP_SHORTCUT = 1</Condition>
        <Shortcut Id="BimeronDesktopShortcutEntry"
                  Name="Bimeron"
                  Target="[#CM_FP_bimeron_desktop.exe]"
                  WorkingDirectory="INSTALL_ROOT" />
        <RegistryValue Root="HKCU"
                       Key="Software\Bimeron Network\bimeron-desktop"
                       Name="desktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <FeatureRef Id="ProductFeature">
      <ComponentRef Id="BimeronStartMenuShortcut" />
      <ComponentRef Id="BimeronDesktopShortcut" />
    </FeatureRef>

    <CustomAction Id="LaunchBimeron"
                  Directory="INSTALL_ROOT"
                  ExeCommand="&quot;[INSTALL_ROOT]bimeron-desktop.exe&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <UI Id="BimeronUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="InstallDir" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Dialog Id="BimeronOptionsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Additional options" />
        <Control Id="TopLine" Type="Line" X="0" Y="25" Width="370" Height="0" />
        <Control Id="Description" Type="Text" X="20" Y="40" Width="330" Height="20"
                 Text="Choose the shortcuts to create and what to do after installation." />
        <Control Id="StartMenuShortcut" Type="CheckBox" X="30" Y="75" Width="310" Height="17"
                 Property="CREATE_START_MENU_SHORTCUT" CheckBoxValue="1"
                 Text="Create a Start menu shortcut" />
        <Control Id="DesktopShortcut" Type="CheckBox" X="30" Y="100" Width="310" Height="17"
                 Property="CREATE_DESKTOP_SHORTCUT" CheckBoxValue="1"
                 Text="Create a desktop shortcut" />
        <Control Id="LaunchAfterInstall" Type="CheckBox" X="30" Y="125" Width="310" Height="17"
                 Property="LAUNCH_AFTER_INSTALL" CheckBoxValue="1"
                 Text="Launch bimeron after installation" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">1</Publish>
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg">LicenseAccepted = "1"</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="BimeronOptionsDlg" Order="2">1</Publish>
      <Publish Dialog="BimeronOptionsDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg">1</Publish>
      <Publish Dialog="BimeronOptionsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="BimeronOptionsDlg">NOT Installed</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg">Installed</Publish>
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchBimeron" Order="1">
        LAUNCH_AFTER_INSTALL = 1 AND NOT Installed
      </Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="2">1</Publish>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
