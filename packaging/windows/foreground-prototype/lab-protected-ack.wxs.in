<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="@LAB_PRODUCT@" Name="Bimeron LABPROTECTEDACK @variant@" Language="1033" Version="0.0.1" Manufacturer="Bimeron" UpgradeCode="@LAB_UPGRADE@">
    <Package Id="*" InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="@WIX_ARCH@" />
    <Media Id="1" />
    <EnsureTable Id="Component" />
    <EnsureTable Id="FeatureComponents" />
    <Binary Id="LabAckBinary" SourceFile="@LAB_DLL@" />
    <CustomAction Id="AckPreflight" BinaryKey="LabAckBinary" DllEntry="AckPreflight" Execute="immediate" Return="check" />
    <CustomAction Id="AckRollback" BinaryKey="LabAckBinary" DllEntry="AckRollback" Execute="rollback" Impersonate="no" Return="check" />
    <CustomAction Id="AckDeferred" BinaryKey="LabAckBinary" DllEntry="AckDeferred" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="AckCommit" BinaryKey="LabAckBinary" DllEntry="AckCommit" Execute="commit" Impersonate="no" Return="check" />
    <CustomAction Id="AckPostFinalize" BinaryKey="LabAckBinary" DllEntry="AckPostFinalize" Execute="immediate" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="AckPreflight" Sequence="1499">NOT Installed</Custom>
      <Custom Action="AckRollback" Sequence="1501">NOT Installed</Custom>
      <Custom Action="AckDeferred" Sequence="1502">NOT Installed</Custom>
      <Custom Action="AckCommit" Sequence="1503">NOT Installed</Custom>
      <Custom Action="AckPostFinalize" Sequence="6601">NOT Installed</Custom>
    </InstallExecuteSequence>
    <Directory Id="TARGETDIR" Name="SourceDir" />
    <Feature Id="EmptyLab" Title="LABPROTECTEDACK" Level="1" />
  </Product>
</Wix>
